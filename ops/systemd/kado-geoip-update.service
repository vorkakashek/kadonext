[Unit]
Description=Update KADO local country lookup database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kado-update-geoip
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=GeoIP
StateDirectoryMode=0755
ReadWritePaths=/var/lib/GeoIP /run/nginx.pid
