# Public endpoint is baked into the static site at build time.
# Keep the default path when the host proxies /api/contact to CONTACT_API_PORT.
NUXT_PUBLIC_CONTACT_ENDPOINT=/api/contact

# Optional static asset CDN. Leave empty for local development.
NUXT_PUBLIC_ASSET_CDN_URL=https://nfb4tt2jyb.cdn.twcstorage.ru

# Optional production UI preview. No form data leaves the browser while true.
# Keep false for every real deployment.
NUXT_PUBLIC_CONTACT_MOCK=false
NUXT_PUBLIC_CONTACT_MOCK_DELAY_MS=500

# Local UI preview only: success shows the full sending/success sequence; error
# shows the delayed delivery error. Ignored when NODE_ENV=production.
CONTACT_DEV_MOCK=
CONTACT_DEV_MOCK_DELAY_MS=500

# Production is indexable. Use false BEFORE building a preview/staging site.
# robots.txt, sitemap.xml and HTML metadata are baked into static output.
NUXT_PUBLIC_SITE_INDEXABLE=true

# Production delivery. SMTP credentials are server-only: never use NUXT_PUBLIC_.
CONTACT_SMTP_HOST=mail.hosting.reg.ru
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=hello@kadonext.com
CONTACT_SMTP_PASS=
# Production setup stores the password in this base64 form to avoid quoting
# problems in systemd EnvironmentFile. Set only one password variable.
CONTACT_SMTP_PASS_BASE64=
CONTACT_MAIL_FROM=KADO <hello@kadonext.com>
CONTACT_MAIL_TO=hello@kadonext.com
CONTACT_ALLOWED_ORIGINS=https://kadonext.com,https://www.kadonext.com,http://localhost:3000
CONTACT_API_HOST=127.0.0.1
CONTACT_API_PORT=3001
CONTACT_TRUST_PROXY=false
# Keep the same random secret across restarts and all API workers.
# Example generator: openssl rand -base64 32
CONTACT_ANTI_SPAM_SECRET=
CONTACT_RATE_LIMIT_PER_HOUR=10
CONTACT_RATE_LIMIT_PER_DAY=30
CONTACT_DUPLICATE_TTL_MS=86400000
CONTACT_TOKEN_TTL_MS=7200000
CONTACT_DECOY_DELAY_MS=500
# ffmpeg and ffprobe are required for audio validation and MP3 conversion.
# Leave empty to use executables from PATH, or set absolute paths on the API host.
CONTACT_FFMPEG_PATH=
CONTACT_FFPROBE_PATH=
