# Public endpoint is baked into the static site at build time.
# Keep the default path when the host proxies /api/contact to CONTACT_API_PORT.
NUXT_PUBLIC_CONTACT_ENDPOINT=/api/contact

# Local UI preview only: success shows the full sending/success sequence; error
# shows the delayed delivery error. Ignored when NODE_ENV=production.
CONTACT_DEV_MOCK=
CONTACT_DEV_MOCK_DELAY_MS=1600

# Server-only settings. Never use NUXT_PUBLIC_ for SMTP credentials.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_MAIL_FROM=KADO <hello@kadonext.com>
CONTACT_MAIL_TO=hello@kadonext.com
CONTACT_ALLOWED_ORIGINS=https://kadonext.com,https://www.kadonext.com,http://localhost:3000
CONTACT_API_HOST=127.0.0.1
CONTACT_API_PORT=3001
CONTACT_TRUST_PROXY=false
# ffmpeg and ffprobe are required for audio validation and MP3 conversion.
# Leave empty to use executables from PATH, or set absolute paths on the API host.
CONTACT_FFMPEG_PATH=
CONTACT_FFPROBE_PATH=
